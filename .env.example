# Variables públicas del frontend
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Variables privadas del servidor: no exponerlas al navegador
SUPABASE_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
HOTMART_HOTTOK=YOUR_HOTMART_HOTTOK
HOTMART_PRODUCT_ID=YOUR_HOTMART_PRODUCT_ID
JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET

# Runtime
NODE_ENV=production
PORT=3000

# Variables opcionales del template heredado
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
